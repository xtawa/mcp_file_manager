# ---- 存储 ----
# 数据目录：元数据索引 index.json、文件实体 files/、临时分片 tmp/ 都在这里
FM_DATA_DIR=./data

# ---- HTTP 服务 ----
# 监听地址与端口。部署到公网时改为 0.0.0.0，并务必设置 FM_API_TOKEN
FM_HOST=127.0.0.1
FM_PORT=8787
# 对外可访问的基础地址，用于拼接下载直链；反向代理 / 公网部署时必须设置
FM_PUBLIC_BASE_URL=http://localhost:8787

# ---- 保留策略 ----
# 默认保留时长（小时）：24 小时后自动删除
FM_TTL_HOURS=24
# 单个文件允许申请的最长保留时长（小时），默认 720（30 天）
FM_MAX_TTL_HOURS=720
# 后台清理任务执行间隔（分钟）
FM_SWEEP_INTERVAL_MINUTES=10

# ---- 限额 ----
# 单文件大小上限（MB）
FM_MAX_UPLOAD_MB=100
# MCP download_file 直接内联返回内容的上限（MB），超过则只返回下载链接
FM_MAX_INLINE_MB=4

# ---- 安全 ----
# 写接口（上传 / 删除 / 列表 / MCP over HTTP）需要的 Token；留空表示不校验，仅适合本机使用
FM_API_TOKEN=
# 是否允许 upload_file 通过 url 抓取远程文件（1/0）
FM_ALLOW_REMOTE_FETCH=1
# 是否允许 upload_file 读取服务器本地路径（1/0）
FM_ALLOW_LOCAL_PATH=1

# ---- 日志 ----
# debug | info | warn | error（日志一律写入 stderr，避免污染 stdio 传输）
FM_LOG_LEVEL=info
