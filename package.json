{
  "name": "mcp-file-manager",
  "version": "0.1.0",
  "description": "MCP 文件中转服务：用户 / AI agent 上传下载文件，返回标识码与直链，文件 24 小时后自动删除。",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-file-manager": "dist/index.js"
  },
  "files": [
    "dist",
    "public",
    "README.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --transport http",
    "dev": "tsx watch src/index.ts",
    "dev:http": "tsx watch src/index.ts --transport http",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "file-manager",
    "file-upload",
    "ai-agent"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "busboy": "^1.6.0",
    "express": "^4.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
